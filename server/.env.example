# Joy Ministries — church API
# Copy to .env for local work, or paste these into Vercel → Settings → Environment Variables.
# Nothing here is a secret in production: replace JWT_SECRET / SESSION_SECRET before going live.

NODE_ENV=production
PORT=38799
# Public origin of this API. PayFast return/cancel/notify URLs and uploaded file
# URLs are built from it, so it must be the real public host, not localhost.
PUBLIC_BASE_URL=https://joyministries.co.za

# --- Database (cPanel MySQL) -----------------------------------------
DB_HOST=joyministries.co.za
DB_PORT=3306
DB_USER=joyministries_church_app
DB_PASSWORD=h_M]W9i3y;MGUv7
DB_NAME=joyministries_church_app
DB_POOL=6
# 1 only if the host requires TLS.
DB_SSL=0

# --- Sessions and tokens ---------------------------------------------
JWT_SECRET=change-me-in-production
SESSION_SECRET=change-me-in-production

# --- Uploads ----------------------------------------------------------
# Local disk works on a normal server. On Vercel the filesystem is read-only
# apart from /tmp, so uploaded media will not persist there — see the note in
# the README before deploying to Vercel.
UPLOADS_DIR=./uploads
MAX_UPLOAD_MB=25

# --- PayFast ----------------------------------------------------------
PAYFAST_MERCHANT_ID=10010868
PAYFAST_MERCHANT_KEY=exnibu0q9zmuz
PAYFAST_PASSPHRASE=
PAYFAST_MODE=sandbox

# Never seed a live database on boot.
SEED=0

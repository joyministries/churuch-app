<%- include('partials/top', { title, me, flash }) %>
<h1>Notifications</h1>
<form method="post" action="/admin/notifications" class="card">
  <label>Title</label><input name="title" required>
  <label>Body</label><textarea name="body" rows="2"></textarea>
  <label>Link</label><input name="link">
  <label>Ministry (blank = church-wide, admin only)</label>
  <select name="ministry_id"><option value="">Church-wide</option><% ministries.forEach(m=>{ %><option value="<%= m.id %>"><%= m.name %></option><% }) %></select>
  <button style="margin-top:10px">Send</button>
</form>
<table><tr><th>ID</th><th>Type</th><th>Title</th><th>Ministry</th><th>Created</th></tr>
<% items.forEach(n=>{ %><tr><td><%= n.id %></td><td><%= n.type %></td><td><%= n.title %></td><td><%= n.ministry_name %></td><td><%= n.created_at %></td></tr><% }) %>
</table>
<%- include('partials/bottom') %>

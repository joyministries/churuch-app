<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Sign in · Joy Ministries Admin</title>
<style>
:root{--bg:#F4F4F2;--panel:#fff;--ink:#1B1B1A;--muted:#6E6E6A;--line:#DEDEDA;--accent:#2F5D7C;--bad:#A5342A}
*{box-sizing:border-box}
html,body{height:100%;margin:0}
body{
  background:var(--bg);color:var(--ink);
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  font-size:13px;line-height:1.45;display:flex;align-items:center;justify-content:center;padding:24px;
  -webkit-font-smoothing:antialiased;
}
.box{width:100%;max-width:336px}
.brand{display:flex;align-items:baseline;gap:8px;margin-bottom:16px}
.brand b{font-size:14px;font-weight:600}
.brand span{font-size:10px;color:var(--muted);border:1px solid var(--line);background:var(--panel);border-radius:3px;padding:1px 6px}
form{background:var(--panel);border:1px solid var(--line);border-radius:4px;padding:18px 18px 20px}
h1{font-size:15px;font-weight:600;margin:0 0 3px}
p.hint{color:var(--muted);font-size:12px;margin:0 0 16px}
label{display:block;margin:12px 0 3px;font-size:11.5px;font-weight:500;color:var(--muted)}
input{
  width:100%;padding:7px 9px;border:1px solid #CFCFCA;border-radius:3px;
  font:inherit;font-size:13px;background:#fff;color:var(--ink);
}
input:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 2px rgba(47,93,124,.12)}
button{
  width:100%;margin-top:18px;padding:8px 12px;border-radius:3px;cursor:pointer;
  background:var(--accent);color:#fff;border:1px solid var(--accent);
  font:inherit;font-size:13px;font-weight:500;
}
button:hover{background:#26506C;border-color:#26506C}
.err{
  margin:0 0 14px;padding:8px 10px;border:1px solid #E0C4C0;border-left:3px solid var(--bad);
  border-radius:3px;background:#FCF3F2;font-size:12px;
}
.foot{margin-top:12px;font-size:11px;color:#94948E;display:flex;justify-content:space-between}
</style>
</head>
<body>
<div class="box">
  <div class="brand"><b>Joy Ministries</b><span>Admin</span></div>
  <form method="post" action="/admin/login">
    <h1>Sign in</h1>
    <p class="hint">Staff and ministry accounts only.</p>

    <% if (typeof flash !== 'undefined' && flash) { %>
      <div class="err"><%= flash.message %></div>
    <% } %>

    <label for="email">Email</label>
    <input id="email" name="email" type="email" autocomplete="username" required autofocus>
    <label for="password">Password</label>
    <input id="password" name="password" type="password" autocomplete="current-password" required>
    <input type="hidden" name="next" value="<%= next %>">
    <button type="submit">Sign in</button>
  </form>
  <div class="foot"><span>console build 2026-11-20c</span><a href="https://joyministries.co.za" style="color:inherit">joyministries.co.za</a></div>
</div>
</body>
</html>

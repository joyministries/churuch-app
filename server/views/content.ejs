<%- include('partials/top', { title, me, flash }) %>
<h1>Notices &amp; devotionals</h1>
<form method="post" action="/admin/content" class="card">
  <div class="row">
    <div><label>Type</label><select name="type"><option>notice</option><option>devotional</option><option>sermon</option><option>media</option></select></div>
    <div style="flex:2"><label>Title</label><input name="title" required></div>
    <div><label>Ministry</label><select name="ministry_id"><option value="">Church-wide</option><% ministries.forEach(m=>{ %><option value="<%= m.id %>"><%= m.name %></option><% }) %></select></div>
  </div>
  <label>Excerpt</label><input name="excerpt">
  <label>Body</label><textarea name="body" rows="4"></textarea>
  <label>Media URL</label><input name="media_url">
  <div class="row" style="margin-top:8px"><label><input type="checkbox" name="is_pinned"> Pinned</label><label><input type="checkbox" name="status" value="published" checked> Published</label></div>
  <button style="margin-top:10px">Save</button>
</form>
<table><tr><th>ID</th><th>Type</th><th>Title</th><th>Ministry</th><th>Status</th></tr>
<% items.forEach(i=>{ %><tr><td><%= i.id %></td><td><%= i.type %></td><td><%= i.title %></td><td><%= i.ministry_name %></td><td><%= i.status %></td></tr><% }) %>
</table>
<%- include('partials/bottom') %>
